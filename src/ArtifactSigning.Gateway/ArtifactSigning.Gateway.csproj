<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <OutputType>Exe</OutputType>
    <AssemblyName>ArtifactSigning.Gateway</AssemblyName>
    <RootNamespace>ArtifactSigning.Gateway</RootNamespace>
    <VersionPrefix>0.8.3</VersionPrefix>
    <Description>Private mTLS request gateway without Authenticode key access.</Description>
    <!-- The executable exposes its closed engine surface to the separately
         built protocol, integration, and installer validation tests. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference Include="..\ArtifactSigning.Profiles\ArtifactSigning.Profiles.csproj" />
    <ProjectReference Include="..\ArtifactSigning.Protocol\ArtifactSigning.Protocol.csproj" />
    <ProjectReference Include="..\ArtifactSigning.Windows\ArtifactSigning.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\eng\InstalledProfileSet.cs" Link="Composition\InstalledProfileSet.cs" />
  </ItemGroup>
</Project>
